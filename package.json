{
    "name": "code-hp",
    "productName": "Code.HP",
    "version": "1.3.6",
    "description": "Code snippet manager with retro-futuristic alien UI",
    "main": "app/main/electron/main.js",
    "author": "lorik",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/lorik440/Code.HP.git"
    },
    "scripts": {
        "start": "electron .",
        "dev": "electronmon .",
        "pack": "electron-builder --dir && powershell -NoProfile -Command Start-Process .\\dist\\win-unpacked\\Code.HP.exe",
        "clean": "rimraf dist",
        "build": "electron-builder --win",
        "release": "npm run clean && electron-builder --win --publish always",
        "dist": "npm run release"
    },
    "build": {
        "appId": "com.lorik.code-hp",
        "productName": "Code.HP",
        "compression": "maximum",
        "publish": [
            {
                "provider": "github",
                "owner": "lorik440",
                "repo": "Code.HP"
            }
        ],
        "directories": {
            "output": "dist"
        },
        "asar": true,
        "files": [
            "app/**/*",
            "node_modules/monaco-editor/min/**/*",
            "node_modules/electron-updater/**/*",
            "node_modules/electron-updater/node_modules/**/*",
            "!**/*.map",
            "!**/*.md",
            "!**/*.xml",
            "!**/test/**",
            "!**/tests/**",
            "!**/__tests__/**",
            "!.github/**/*",
            "!scripts/**/*",
            "!LICENSE",
            "!snippets/**/*",
            "!app/assets/screenshots/**/*"
        ],
        "extraResources": [
            {
                "from": "app/assets/fonts",
                "to": "fonts"
            }
        ],
        "win": {
            "signExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "app/assets/icons/AppLogo.ico"
        },
        "nsis": {
            "oneClick": true,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "devDependencies": {
        "electron": "^43.0.0",
        "electron-builder": "^26.15.3",
        "electronmon": "^2.0.4",
        "rimraf": "^6.1.3"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "electron-updater": "^6.8.9",
        "monaco-editor": "^0.53.0"
    }
}
